{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#1C1C1E",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#FF9500",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#F2F2F7",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#8E8E93",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#E5E5EA",
					"name": "Border",
					"slug": "border"
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"wideSize": "100%"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"size": "4px",
					"name": "Tiny"
				},
				{
					"slug": "20",
					"size": "8px",
					"name": "XX-Small"
				},
				{
					"slug": "30",
					"size": "12px",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "16px",
					"name": "Small"
				},
				{
					"slug": "50",
					"size": "24px",
					"name": "Medium"
				},
				{
					"slug": "60",
					"size": "32px",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "48px",
					"name": "X-Large"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.8125rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "0.9375rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.375rem",
					"name": "Large",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "Title",
					"fluid": {
						"min": "1.75rem",
						"max": "2rem"
					}
				}
			],
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif",
					"name": "System",
					"slug": "system"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			}
		},
		"spacing": {
			"margin": {
				"top": "0",
				"bottom": "0"
			},
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
